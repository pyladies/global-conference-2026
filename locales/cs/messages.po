msgstr ""
"<code class=\"text-accent\">#game</code>, kde najdete malou hru, kterou jsme "
"pro vás připravili,"

#: src/pages/[lang]/attending.astro:206
msgid ""
"<code class=\"text-accent\">#game-ranking</code>, to see the ranking of the "
"game!,"
msgstr ""
"<code class=\"text-accent\">#game-ranking</code>, kde najdete ranking hry!,"

