msgid "Duration"
msgstr "Διάρκεια"

#: src/pages/[lang]/session/[...session].astro:100
msgid "minutes"
msgstr "λεπτά"

#: src/pages/[lang]/session/[...session].astro:112
msgid "Abstract"
msgstr "Περίληψη"

