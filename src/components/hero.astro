---
import Ornament from "@components/brand/ornament.astro";
import Link from "@components/ui/link.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

{/*
  The hero is one celestial composition inside a rounded frame. `hero-art` is
  the whole ornament layer lifted straight out of the 2026 comp (hands, rays,
  moons, constellations, the PyLadies flower and the moon phases) as a single
  monochrome SVG, so it scales perfectly and recolours with the theme. Only the
  copy and the two buttons live in HTML on top of it.
*/}
<section class="px-4 pt-6 sm:px-6 lg:px-8" aria-labelledby="hero-title">
  <div
    class="relative mx-auto max-w-[1392px] overflow-hidden rounded-3xl border-[3px] border-hairline-strong">
    {/* mask-size: contain does the same job as preserveAspectRatio="meet". */}
    <Ornament
      name="hero-art"
      class="pointer-events-none absolute inset-0 hidden h-full w-full md:block"
    />

    {/* Keeps the frame at the comp's proportions once the artwork is visible. */}
    <div class="hidden md:block md:aspect-[1392/659]"></div>

    {/*
      From `md` up the copy is pinned to the same 26% mark the comp uses, so it
      lands in the clear channel between the crest above and the flower below.
      Percentage `top` resolves against the frame's height; percentage padding
      would resolve against its width, which is why this is absolute.
    */}
    <div
      class="relative flex flex-col items-center px-5 py-14 text-center sm:px-8 md:absolute md:inset-x-0 md:top-[26%] md:py-0">
      {/* On phones the full composition has nowhere to go, so a few celestial
          marks stand in for it. */}
      <div class="mb-8 flex items-center gap-x-8 md:hidden">
        <Ornament name="moon-crescent" class="h-12 w-auto" />
        <Ornament name="pyladies-flower" class="h-14 w-auto" />
        <Ornament name="sun-burst" class="h-12 w-auto" />
      </div>

      <h1
        id="hero-title"
        class="font-display text-[clamp(1.9rem,5.2vw,4rem)] font-black leading-none tracking-tight text-title">
        {t("PyLadiesCon 2026")}
      </h1>

      <p class="mt-3 text-base text-ink sm:text-lg">
        {t("The global online PyLadies conference")}
      </p>

      <p class="mt-2 text-xs font-semibold tracking-wide text-ink sm:text-sm">
        {t("5–7 December 2026 · Online · Multi-language · Multi-timezone")}
      </p>

      <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row lg:mt-10">
        <Link href="/donate" style="primary" size="lg" class="uppercase tracking-wide">
          {t("Get your ticket")}
        </Link>
        <Link
          href={translatePath("/schedule")}
          style="outline"
          size="lg"
          class="uppercase tracking-wide">
          {t("View schedule")}
        </Link>
      </div>

      <Ornament name="moon-phases" class="mt-10 h-6 w-auto md:hidden" />
    </div>
  </div>
</section>

{/* The Orchid band that carries the conference's one-line promise. */}
<div class="mt-10 bg-band py-10 sm:py-12">
  <p
    class="mx-auto max-w-3xl px-6 text-center text-xl font-bold leading-relaxed text-on-band sm:text-2xl">
    {t("The online conference of the PyLadies communities around the globe.")}
  </p>
</div>
