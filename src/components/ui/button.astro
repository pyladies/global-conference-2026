---
interface Props {
	size?: "sm" | "md" | "lg";
	block?: boolean;
	style?: "outline" | "primary" | "link";
	class?: string;
	[x: string]: any;
}

const {
	size = "md",
	style = "primary",
	block,
	class: className,
	...rest
} = Astro.props;

const sizes = {
	sm: "px-3 py-1.5",
	md: "min-h-11 px-3.5 py-2.5",
	lg: "min-h-11 px-6 py-3",
};

const styles = {
	outline:
		"border-2 border-hairline-strong bg-surface text-ink hover:bg-orchid hover:text-nearwhite",
	primary:
		"border-2 border-lavender bg-accent text-on-accent hover:bg-orchid hover:text-nearwhite",
	link: "text-center text-sm font-semibold text-ink transition hover:bg-accent/10 hover:text-ink-strong focus:bg-accent/10 focus:text-ink-strong focus:outline-none",
};
---

<button
	{...rest}
	class:list={[
		"rounded-md text-center transition focus-visible:ring-2 ring-offset-2 ring-hairline",
		block && "w-full",
		sizes[size],
		styles[style],
		className,
	]}>
	<slot />
</button>
