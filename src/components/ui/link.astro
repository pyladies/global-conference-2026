---

interface Props {
	href: string;
	size?: "xs" | "sm" | "md" | "lg";
	block?: boolean;
	style?: "outline" | "primary" | "hover" | "muted";
	class?: string;
	[x: string]: any;
}

const {
	href,
	block,
	size = "md",
	style = "primary",
	class: className,
	...rest
} = Astro.props;

// Minimum control height is 44px in the 2026 kit, hence the min-h on md/lg.
const sizes = {
	xs: "",
	sm: "px-3 py-1.5",
	md: "min-h-11 px-4 py-2.5",
	lg: "min-h-11 px-6 py-3",
};

/*
 * Only the button-shaped styles set a display. Keeping `inline-flex` out of the
 * shared base matters: Tailwind emits display utilities in its own canonical
 * order, not source order, so a base `inline-flex` would beat a `block` passed
 * in by a caller — which is how the navbar dropdown items ended up on one row.
 */
const styles = {
	outline:
		"inline-flex items-center justify-center text-center border-2 border-hairline-strong bg-surface text-ink transition-colors hover:bg-orchid hover:text-nearwhite",
	primary:
		"inline-flex items-center justify-center text-center border-2 border-lavender bg-accent text-on-accent shadow-sm transition-colors hover:bg-orchid hover:text-nearwhite",
	muted: "text-sm font-semibold leading-6 text-ink",
	hover:
		"text-center text-ink transition-colors hover:bg-accent/10 hover:text-ink-strong focus:bg-accent/10 focus:text-ink-strong focus:outline-none",
};
---

<a
	href={href} //localizePath(href)}
	{...rest}
	class:list={[
		// plc-btn opts out of the prose link underline/hover in global.css
		style !== "muted" && "plc-btn",
		"rounded-lg text-sm font-semibold transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2",
		block && "w-full",
		sizes[size],
		styles[style],
		className,
	]}>
	<slot />
</a>
