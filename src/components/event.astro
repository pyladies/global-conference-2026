---
import Flourishes from "@components/brand/flourishes.astro";
import Ornament from "@components/brand/ornament.astro";
import SectionTitle from "@components/brand/sectiontitle.astro";
import Link from "@components/ui/link.astro";
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

/*
 * The 2026 edition is built around participation rather than a talk track:
 * tutorials/workshops, sprints, open spaces, PyJam and panels. Keep the copy
 * free of "talks", "keynotes" and "speakers" so it matches the programme.
 */
const features = [
  {
    title: t("Experience"),
    description: t("At PyLadiesCon, we’re bringing the Python world right to your screen. Mark your calendars for the first weekend of December and join us for three days of learning and community."),
    url: "#",
  },
  {
    title: t("The Goal"),
    description: t("This conference is designed to promote diversity, learning, and empowerment within the Python community. We enthusiastically welcome contributions from members and supporters of the PyLadies Community. Prior experience is not required. Everyone is welcome to share your insights and expertise."),
    url: "#",
  },
  {
    title: t("The Languages"),
    description: t("Given that we are a global community, our sessions run in the following languages: English, Español, Português, Deutsch, 日本語 and 中文."),
    url: "#",
  },
  {
    title: t("Tutorials and Workshops"),
    description: t("Hands-on sessions where you follow along and build something yourself. Bring your laptop and leave with a new skill you have actually practised."),
    url: "#",
  },
  {
    title: t("Sprints"),
    description: t("Contribute to an open source project alongside the people who maintain it. First-time contributors are especially welcome, and there will be someone to help you get set up."),
    url: "#",
  },
  {
    title: t("Open Spaces"),
    description: t("Motivated during the event? Organize an open space for people to gather and discuss any topic!"),
    url: "#",
  },
  {
    title: t("PyJam"),
    description: t("A showcase where community members share a performance. The line-up is curated and still being put together, so it is not open sign-up this edition, but it will be one to watch."),
    url: "#",
  },
  {
    title: t("Engaging Panels"),
    description: t("Join thought-provoking discussions on topics ranging from Python development to career growth and beyond."),
    url: "#",
  },
  {
    title: t("Collaborative Networking"),
    description: t("Connect with fellow Python enthusiasts, expand your professional network, and forge new friendships."),
    url: "#",
  },
  {
    title: t("Volunteer"),
    description: t("We would not be able to run this conference without help from our volunteers. Please check the Volunteer guide for more details on how to volunteer!"),
    url: "#",
  },
];
---

<section class="relative py-24 sm:py-32" id="event">
  <Flourishes position="top" />
  <Flourishes position="bottom" />

  <div class="relative mx-auto max-w-5xl px-6 lg:px-8">
    <SectionTitle
      mark="palm-hand"
      eyebrow={t("Conference Details")}
      title={t("The Event")}>
      <p class="mt-6 text-lg leading-8 text-ink">
        {t("PyLadies Conference (PyLadiesCon) is the fourth PyLadies conference held– an exciting online and FREE event dedicated to empowerment, learning, and diversity within the Python community! 🎉")}
      </p>
    </SectionTitle>

    <dl class="mx-auto mt-16 grid max-w-2xl grid-cols-1 gap-6 sm:mt-20 lg:max-w-none lg:grid-cols-2">
      {
        features.map((item) => (
          <div class="flex flex-col rounded-xl border-2 border-hairline bg-surface-raised p-6">
            <Ornament name="card-sparkle" class="h-5 w-5 text-ornament" />
            <dt class="mt-4 text-base font-semibold leading-7 text-ink-strong">
              {item.title}
            </dt>
            <dd class="mt-2 flex flex-auto flex-col text-sm leading-6 text-ink">
              <p class="flex-auto">{item.description}</p>
              {item.url !== "#" && (
                <p class="mt-4">
                  <Link href={item.url} style="muted" size="xs" class="text-left">
                    {t("Learn more")}{" "}
                    <span class="pl-1" aria-hidden="true">
                      →
                    </span>
                  </Link>
                </p>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
