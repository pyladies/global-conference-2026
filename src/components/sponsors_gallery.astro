---
import ComingSoon from "@components/brand/comingsoon.astro";
import SectionTitle from "@components/brand/sectiontitle.astro";
import Link from "@components/ui/link.astro";
import { Image } from "astro:assets";
import sixFeetUp from "../assets/sponsors/six_feet_up.png";
import psf from "../assets/sponsors/psf.png";
import ohf from "../assets/sponsors/OHF.png";
import meta from "../assets/sponsors/meta.png";
import quansight from "../assets/sponsors/quansight.png";
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

interface Props {
	/** Link out to the sponsorship page. Off where that would self-reference. */
	showLink?: boolean;
}

interface Sponsor {
	name: string;
	logo: ImageMetadata;
	url: string;
	/** Tile background, for logos that do not read on the default Near White. */
	bg?: string;
}

const { showLink = true } = Astro.props;

/*
 * Add a sponsor by pushing { name, logo, url } onto the `sponsors` array of its
 * tier. Tiers without sponsors are not rendered at all (not even their title).
 * While no tier has any sponsor, a ComingSoon panel is shown instead.
 *
 * Tile widths follow the comp, except Champion, which is enlarged from the
 * comp's 364px to 460px: Champion 460px, Supporters 320px, Connectors 283px,
 * Partner 178px, all at a 2:1 ratio on a Near White tile.
 */
const tiers = [
  {
    name: t("Champion"),
    width: "max-w-[460px]",
    sponsors: [
      { name: "Open Home Foundation", logo: ohf, url: "https://www.openhomefoundation.org", bg: "bg-midnight" },
    ] as Sponsor[],
  },
  {
    name: t("Supporters"),
    width: "max-w-[320px]",
    sponsors: [
      { name: "Meta", logo: meta, url: "https://www.meta.com/" },
    ] as Sponsor[],
  },
  {
    name: t("Connectors"),
    width: "max-w-[283px]",
    sponsors: [
      { name: "Python Software Foundation (PSF)", logo: psf, url: "https://www.python.org/psf-landing/", bg: "bg-midnight" },
    ] as Sponsor[],
  },
  {
    name: t("Partner"),
    width: "max-w-[178px]",
    sponsors: [
      { name: "Six Feet Up", logo: sixFeetUp, url: "https://sixfeetup.com" },
      { name: "Quansight, PBC", logo: quansight, url: "https://www.quansight.com/" },
    ] as Sponsor[],
  },
];

const activeTiers = tiers.filter((tier) => tier.sponsors.length > 0);
---

<section class="py-24 sm:py-32" id="sponsors">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <SectionTitle
      mark="crystal-ball"
      eyebrow={t("Meet the sponsors of our conference.")}
      title={t("Our Sponsors")}
    />

    {
      activeTiers.length > 0 ? (
        <div class="mt-16 space-y-16 sm:mt-20">
          {activeTiers.map((tier) => (
            <div>
              <h3 class="text-xl font-bold text-title sm:text-2xl" id={`${tier.name.toLowerCase()}-sponsors`}>
                {tier.name}
              </h3>
              <div class="mt-6 flex flex-wrap items-center justify-start gap-6">
                {tier.sponsors.map((s) => (
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={s.name}
                    class:list={["flex aspect-[2/1] w-full items-center justify-center rounded-lg border-2 border-orchid p-6 transition-opacity hover:opacity-80", s.bg ?? "bg-nearwhite", tier.width]}>
                    <Image src={s.logo} alt={s.name} width={400} class="max-h-full max-w-full object-contain" />
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      ) : (
      <ComingSoon
        class="mt-16 sm:mt-20"
        title={t("Our sponsors coming soon")}
        message={t("Sponsorship for this edition is still open, so there is nobody to thank here just yet. Take a look at the sponsorship page to find out how your organization can support the conference.")}>
        {
          showLink && (
            <Link
              href={translatePath("/sponsors")}
              style="primary"
              size="lg"
              class="mt-8">
              {t("See sponsorship options")}
            </Link>
          )
        }
      </ComingSoon>
      )
    }

    {
      activeTiers.length > 0 && showLink && (
        <div class="mt-16 text-center sm:mt-20">
          <h3 class="text-xl font-bold text-title sm:text-2xl">
            {t("Want to see your logo here?")}
          </h3>
          <p class="mx-auto mt-4 max-w-2xl text-base text-ink">
            {t("Sponsorship for this edition is still open. Take a look at the sponsorship page to find out how your organization can support the conference.")}
          </p>
          <Link
            href={translatePath("/sponsors")}
            style="outline"
            size="lg"
            class="mt-8">
            {t("See sponsorship options")}
          </Link>
        </div>
      )
    }
  </div>
</section>
