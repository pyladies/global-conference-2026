---
import ComingSoon from "@components/brand/comingsoon.astro";
import SectionTitle from "@components/brand/sectiontitle.astro";
import Link from "@components/ui/link.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

interface Props {
	/** Link out to the sponsorship page. Off where that would self-reference. */
	showLink?: boolean;
}

const { showLink = true } = Astro.props;

/*
 * Sponsorship for this edition is still open, so the tier tiles are parked and
 * a ComingSoon panel stands in for them.
 *
 * The tiers below stay in the frontmatter — server-side only, so none of this
 * reaches the built page. To publish, give a tier a `sponsors` array
 * (name / logo / url) and put this back in place of the panel in the template:
 *
 *   <div class="mt-16 space-y-16 sm:mt-20">
 *     {tiers.map((tier) => (
 *       <div>
 *         <h3 class="text-xl font-bold text-title sm:text-2xl" id={`${tier.name.toLowerCase()}-sponsors`}>
 *           {tier.name}
 *         </h3>
 *         <div class="mt-6 flex flex-wrap items-center justify-center gap-6">
 *           {tier.sponsors.length > 0
 *             ? tier.sponsors.map((s: any) => (
 *                 <a href={s.url} class:list={["flex aspect-[2/1] w-full items-center justify-center rounded-lg border-2 border-orchid bg-nearwhite p-6 transition-opacity hover:opacity-80", tier.width]}>
 *                   <img src={s.logo} alt={s.name} loading="lazy" class="max-h-full max-w-full object-contain" />
 *                 </a>
 *               ))
 *             : Array.from({ length: tier.placeholders }).map(() => (
 *                 <div class:list={["flex aspect-[2/1] w-full items-center justify-center rounded-lg border-2 border-orchid bg-nearwhite", tier.width]} aria-hidden="true">
 *                   <span class="text-xs font-medium tracking-wide text-orchid">{t("LOGO")}</span>
 *                 </div>
 *               ))}
 *         </div>
 *       </div>
 *     ))}
 *   </div>
 *
 * Tile widths follow the comp: Champion 364px, Supporters 283px, Connectors
 * 178px, all at a 2:1 ratio on a Near White tile.
 */
const tiers = [
  { name: t("Champion"), width: "max-w-[364px]", placeholders: 1, sponsors: [] },
  { name: t("Supporters"), width: "max-w-[283px]", placeholders: 2, sponsors: [] },
  { name: t("Connectors"), width: "max-w-[178px]", placeholders: 2, sponsors: [] },
];
---

<section class="py-24 sm:py-32" id="sponsors">
  <div class="mx-auto max-w-6xl px-6 lg:px-8">
    <SectionTitle
      mark="crystal-ball"
      eyebrow={t("Meet the sponsors of our conference.")}
      title={t("Our Sponsors")}
    />

    <ComingSoon
      class="mt-16 sm:mt-20"
      title={t("Our sponsors coming soon")}
      message={t("Sponsorship for this edition is still open, so there is nobody to thank here just yet. Take a look at the sponsorship page to find out how your organization can support the conference.")}>
      {
        showLink && (
          <Link
            href={translatePath("/sponsors")}
            style="primary"
            size="lg"
            class="mt-8">
            {t("See sponsorship options")}
          </Link>
        )
      }
    </ComingSoon>
  </div>
</section>
