---
import Ornament from "@components/brand/ornament.astro";

/*
 * The organizer "tarot card": a bordered portrait card with a ray fan in each
 * corner, a circular photo, the name, the role, and the ☾ ✦ ☽ rule at the foot.
 * Geometry follows the comp — 202×312 with the portrait inset 36px.
 */
interface Props {
	name: string;
	role?: string;
	photo?: string;
	class?: string;
}

const { name, role, photo, class: className } = Astro.props;
---

<div
	class:list={[
		"relative flex aspect-[202/312] w-full max-w-[202px] flex-col items-center overflow-hidden rounded-[17px] border-2 border-hairline-strong bg-surface-raised",
		className,
	]}>
	{/* One ray fan, mirrored into all four corners. */}
	<Ornament name="card-corner" class="absolute left-[5%] top-[4%] w-[41%]" />
	<Ornament name="card-corner" class="absolute right-[5%] top-[4%] w-[41%]" flip />
	<Ornament name="card-corner" class="absolute bottom-[4%] left-[5%] w-[41%] -scale-y-100" />
	<Ornament
		name="card-corner"
		class="absolute bottom-[4%] right-[5%] w-[41%] -scale-y-100"
		flip
	/>

	<div class="relative mt-[11%] w-[66%] overflow-hidden rounded-full border-2 border-hairline bg-lilac">
		{
			photo ? (
				<img
					src={photo}
					alt=""
					loading="lazy"
					class="aspect-square w-full object-cover"
				/>
			) : (
				<div class="aspect-square w-full" />
			)
		}
	</div>

	<p class="mt-[6%] px-2 text-center text-xs font-bold uppercase leading-tight tracking-wide text-ink-strong sm:text-sm">
		{name}
	</p>
	{
		role && (
			<p class="mt-1 px-2 text-center text-[11px] leading-tight text-accent">
				{role}
			</p>
		)
	}

	<Ornament name="card-moons" class="absolute bottom-[13%] w-[28%]" />
</div>
