---
import ComingSoon from "@components/brand/comingsoon.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import Layout from "@layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getLocaleStaticPaths } from "../../i18n/locales";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

/*
 * To publish the sprint projects, replace the <ComingSoon /> panel in the
 * template with:
 *
 *   <div class="grid md:grid-cols-1 gap-10 mx-auto max-w-5xl mt-10">
 *     {sprintsData.map((sprint) => ( ...project card... ))}
 *   </div>
 *
 * The card markup is in git history for this file.
 */
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { align = "center" } = Astro.props;

/*
 * Sprint projects are parked until the line-up for this edition is confirmed.
 * The list below is last edition's and is kept so it can be edited in place —
 * it lives in the frontmatter, so nothing here reaches the built page while the
 * grid is not rendered. To publish: swap the <ComingSoon /> panel below back for
 * the project grid (see the comment there).
 */
const sprintsData = [
// {
//  name: "Project ",
//  project_url: "https://github.com/myossp/project1"
//  project_doc_url: "https://docs.myossproject.com",
//  description: "This is an example project that will help you contribute to an OSS initiative!",
// level: "Beginner friendly, Some math knowledge",
// languages: "Python, Rust",
// maintainers_discord: ["username1", "username2"]
//  },
{
   name: "Skrub",
   project_url: "https://github.com/skrub-data/skrub/",
   project_doc_url: "https://skrub-data.org",
   description: "Skrub is a Python library to ease preprocessing and feature engineering for tabular machine learning. It allows easily applying scikit-learn estimators to complex pandas and polars dataframes.",
   level: "Any level",
   languages: "Python",
 },
{
   name: "PyLadiesCon Website Translation",
   project_url: "https://github.com/pyladies/global-conference-2026/",
   project_doc_url: "https://github.com/pyladies/global-conference-2026/blob/main/docs/translating.md",
   description: "This repo hosts the PyLadiesCon 2026 website, and we’re looking for contributors to help wrap untranslated text and add or update language files so the site becomes fully multilingual.",
   level: "Any level",
   languages: "Astro, HTML",
   maintainers_discord: ["vadal7373"]
 },
 {
   name: "Python Docs El",
   project_url: "https://github.com/python/python-docs-el",
   project_doc_url: "https://python-docs-el.readthedocs.io/el/latest/",
   description: "The Greek Translation of Python Documentation. It is a good opportunity for someone to make Python accessible to the Greek people and also learn Git, Github and copperate with others.",
   level: "Any level",
   languages: "Python, Makefile",
   maintainers_discord: ["panoshad", "artemisln", "sloop.official"]
 },
 {
   name: "DataJourney",
   project_url: "https://github.com/DataJourneyHQ/DataJourney",
   project_doc_url: "https://github.com/DataJourneyHQ/DataJourney/wiki/Contribute-to-DataJourney",
   description: "A friendly Design first Open Source Data Management Toolkit",
   level: "Beginner friendly",
   languages: "Python, HTML",
   maintainers_discord: ["sayantika_hq"]
 },
];

---

<Layout title="Sprints">
  <Container>
    <Sectionhead>
      <Fragment slot="subtitle">{t("Share, learn and contribute!")}</Fragment>
      <Fragment slot="title">Sprints</Fragment>
      <Fragment slot="description">
      {t("Sprints are informal coding sessions, and knowledge sharing where people gather together to work on Open-Source projects, suggest changes in existing libraries solve problems. A Sprint is an opportunity for learning and self-development while contributing to Open Source projects.")}
      <br/>
      <span set:html={t("We encourage maintainers to submit their projects by checking out our <a href=\"https://conference.pyladies.com/docs/speakers/sprints_guide/\" class=\"text-accent\" target=\"_blank\">sprints guide</a>.")} />
      <br/>
      <span set:html={t("Sprint dates and times are still to be confirmed (TBD).")} />
      </Fragment>
    </Sectionhead>

    <ComingSoon
      class="mt-10"
      title={t("Sprint projects coming soon")}
      message={t("We are still gathering the projects for this edition. If you maintain an open source project and would like to host a sprint, check out our sprints guide and get in touch!")}
    />
  </Container>
</Layout>
