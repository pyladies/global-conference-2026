---
import ComingSoon from "@components/brand/comingsoon.astro";
import Container from "@components/container.astro";
import Ornament from "@components/brand/ornament.astro";
import Sectionhead from "@components/sectionhead.astro";
import Layout from "@layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { getLocaleStaticPaths } from "../../i18n/locales";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

/*
 * Placeholder until the 2026 programme exists.
 *
 * The real, fully built schedule page is preserved next to this one as
 * _schedule.astro — Astro does not route files whose name starts with "_", so
 * it stays in the repo without being published. Same for _sessions.astro and
 * _speakers.astro. To bring the programme back:
 *
 *   1. `pnpm program:fetch` to repopulate src/data/{sessions,speakers,schedule}.json
 *   2. delete this file and rename _schedule.astro -> schedule.astro
 *      (and _sessions.astro / _speakers.astro likewise)
 *   3. uncomment the Schedule / Sessions / Speakers entries in data/menuItems.ts
 *
 * This route is kept live because the hero's "View schedule" button links here.
 */
---

<Layout title={t("Schedule")}>
  <Container>
    <Sectionhead>
      <Fragment slot="title">{t("Schedule")}</Fragment>
      <Fragment slot="subtitle"> </Fragment>
      <Fragment slot="description"> </Fragment>
    </Sectionhead>

    <ComingSoon
      class="mt-10"
      title={t("Programme coming soon")}
      message={t("We are still putting the programme together. Tutorials, workshops, sprints, open spaces, PyJam and panels will be announced here — check back soon!")}
    />

    <div class="flex justify-center py-16">
      <Ornament name="moon-phases" class="h-8 w-auto" />
    </div>
  </Container>
</Layout>
