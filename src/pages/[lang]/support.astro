---
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import Link from "@components/ui/link.astro";
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";
import blackPythonDevs from "../../assets/support/black_python_devs.png";
import pythonAsia from "../../assets/support/python_asia.png";
import djangoGirls from "../../assets/support/django_girls.png";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { getLocaleStaticPaths } from "../../i18n/locales";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

/*
 * Wording note: this page deliberately says "Support" and never "donate",
 * "donation" or "economically help". Keep it that way when editing or
 * translating. (The Django Girls URL contains "donate"; that is their link.)
 */
const initiatives = [
  {
    name: "Black Python Devs",
    logo: blackPythonDevs,
    description: t("A community for Black developers in the Python ecosystem, creating space for connection, mentorship and growth."),
    url: "https://blackpythondevs.org/support/",
  },
  {
    name: "Python Asia Organization",
    logo: pythonAsia,
    description: t("Growing and connecting Python communities across Asia through conferences and local events."),
    url: "https://pythonasia.org/sponsors/",
  },
  {
    name: "Django Girls",
    logo: djangoGirls,
    description: t("Free workshops that introduce women to programming and web development with Python and Django."),
    url: "https://djangogirls.org/en/donate/donate/",
  },
];

const waysToSupport = [
  {
    html: `${t("Become a sponsor - contact us at")} <a href="mailto:sponsors@pyladies.com" class="text-accent hover:underline">sponsors@pyladies.com</a>`,
  },
  {
    html: `<a href="https://conference.pyladies.com/docs/#section-volunteers" class="text-accent hover:underline">${t("Volunteer your time and skills to help organize the conference")}</a>`,
  },
  { html: t("Spread the word about PyLadiesCon on social media") },
  { html: t("Join or start a local PyLadies chapter") },
];
---

<Layout title={t("Support")}>
  <Container>
    <Sectionhead>
      <Fragment slot="title">{t("Support PyLadiesCon")}</Fragment>
      <Fragment slot="subtitle">{t("Make a Difference")}</Fragment>
      <Fragment slot="description">
        {t("PyLadiesCon is an exciting online event dedicated to empowerment, learning, and diversity within the Python community. Organized by PyLadies, a global mentorship group helping more women and other minority groups in tech become active participants and leaders in the Python open source community, your support will help improve the diversity of the software industry as a whole.")}
      </Fragment>
    </Sectionhead>

    <div class="mx-auto mt-12 max-w-6xl">
      <div class="mb-12 grid gap-6 md:grid-cols-3">
        <div class="rounded-lg border border-hairline bg-surface p-6 shadow-lg">
          <div class="mb-4 text-4xl" aria-hidden="true">🌍</div>
          <h3 class="mb-2 text-xl font-bold text-ink-strong">{t("Global Reach")}</h3>
          <p class="text-ink">{t("Help us bring PyLadies communities together from around the world.")}</p>
        </div>
        <div class="rounded-lg border border-hairline bg-surface p-6 shadow-lg">
          <div class="mb-4 text-4xl" aria-hidden="true">🎯</div>
          <h3 class="mb-2 text-xl font-bold text-ink-strong">{t("Free Access")}</h3>
          <p class="text-ink">{t("Keep the conference free and accessible to all participants.")}</p>
        </div>
        <div class="rounded-lg border border-hairline bg-surface p-6 shadow-lg">
          <div class="mb-4 text-4xl" aria-hidden="true">💝</div>
          <h3 class="mb-2 text-xl font-bold text-ink-strong">{t("Community Support")}</h3>
          <p class="text-ink">{t("Support the PyLadies community and help organize future events.")}</p>
        </div>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        <!-- Global PyLadies Organization: full width row (colspan 3) -->
        <div class="overflow-hidden rounded-2xl border border-hairline bg-surface shadow-2xl md:col-span-3">
          <div class="bg-gradient-to-r from-lavender via-orchid to-orchid p-6 text-white">
            <h2 class="text-center text-2xl font-bold">{t("Global PyLadies Organization")}</h2>
            <p class="mt-2 text-center text-white/90">
              {t("All support is managed by the Python Software Foundation.")}
            </p>
          </div>

          <div class="p-8 text-center sm:p-12">
            <div class="mx-auto max-w-2xl">
              <div class="mb-6 text-6xl" aria-hidden="true">💝</div>
              <h3 class="mb-4 text-2xl font-bold text-ink-strong">
                {t("Ready to Make a Difference?")}
              </h3>
              <p class="mb-8 text-lg text-ink">
                {t("Click the button below to proceed to our support form. You'll be redirected to the Python Software Foundation's payment system.")}
              </p>
              <Link
                href="https://psfmember.org/civicrm/contribute/transact/?reset=1&id=6"
                target="_blank"
                rel="noopener noreferrer"
                style="primary"
                size="lg">
                {t("Proceed to Support Form")}
              </Link>
              <div class="mt-8 flex items-center justify-center gap-2 text-sm text-ink-muted">
                <span class="text-lg" aria-hidden="true">🔒</span>
                <span>{t("Payment is processed securely via PayPal or physical check (US only)")}</span>
              </div>
            </div>
          </div>

          <div class="flex items-center gap-3 border-t border-hairline bg-surface-raised p-6">
            <div class="text-xl" aria-hidden="true">ℹ️</div>
            <p class="text-sm text-ink">
              {t("The Python Software Foundation is a 501(c)(3) non-profit organization.")}
            </p>
          </div>
        </div>

        <!-- Other initiatives: colspan 1 each -->
        {
          initiatives.map((item) => (
            <div class="flex flex-col rounded-lg border border-hairline bg-surface p-6 shadow-lg">
              <div class="mb-4 flex h-28 items-center justify-center overflow-hidden rounded-md">
                <Image
                  src={item.logo}
                  alt={item.name}
                  width={400}
                  class="max-h-full max-w-full object-contain"
                />
              </div>
              <h3 class="mb-2 text-xl font-bold text-ink-strong">{item.name}</h3>
              <p class="flex-1 text-ink">{item.description}</p>
              <Link
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                style="outline"
                class="mt-6">
                {t("Support")} {item.name}
              </Link>
            </div>
          ))
        }
      </div>

      <p class="mx-auto mt-8 max-w-2xl text-center text-lg text-ink">
        {t("Consider also supporting the many other Python-related initiatives around the world.")}
      </p>

      <div class="mt-12 rounded-lg border border-hairline/40 bg-accent/10 p-6">
        <h3 class="mb-3 text-xl font-bold text-ink-strong">{t("Other Ways to Support")}</h3>
        <ul class="space-y-2 text-ink">
          {
            waysToSupport.map((way) => (
              <li class="flex items-start gap-2">
                <span class="mt-1 text-accent" aria-hidden="true">→</span>
                <span set:html={way.html} />
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-12 pb-12 text-center">
        <h3 class="mb-4 bg-gradient-to-r from-lavender via-orchid to-orchid bg-clip-text text-3xl font-bold text-transparent">
          {t("Thank You for Your Support!")}
        </h3>
        <p class="mx-auto max-w-2xl text-ink">
          {t("Your generosity makes it possible for PyLadies communities worldwide to connect, learn, and grow together.")}
        </p>
      </div>
    </div>
  </Container>
</Layout>
