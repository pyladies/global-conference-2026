---
import ComingSoon from "@components/brand/comingsoon.astro";
import AttendeesTable from "@components/attendeestable.astro";
import Container from "@components/container.astro";
// Sponsorship FAQ explains the parked tiers; restore with them.
// import Faq from "@components/sponsorship_faq.astro";
import Link from "@components/ui/link.astro";
// import Sponsors from "@components/sponsors.astro";
import Sectionhead from "@components/sectionhead.astro";
import Layout from "@layouts/Layout.astro";
import SponsorsGallery from "@components/sponsors_gallery.astro";
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getLocaleStaticPaths } from "../../i18n/locales";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { align = "center" } = Astro.props;


/*
 * Attendee survey, previous edition. Percentages are share of tickets sold
 * (914), which is what sponsors care about, rather than share of the
 * 752 people who answered this question.
 */
const attendeesExperience = [
  {
    position: "Student",
    count: "160",
    percentage: "17.5%",
  },
  {
    position: "Mid-level",
    count: "155",
    percentage: "17.0%",
  },
  {
    position: "Junior",
    count: "136",
    percentage: "14.9%",
  },
  {
    position: "Senior",
    count: "123",
    percentage: "13.5%",
  },
  {
    position: "Associate",
    count: "48",
    percentage: "5.3%",
  },
  {
    position: "Lead",
    count: "45",
    percentage: "4.9%",
  },
  {
    position: "Manager",
    count: "34",
    percentage: "3.7%",
  },
  {
    position: "Other",
    count: "22",
    percentage: "2.4%",
  },
  {
    position: "Director",
    count: "17",
    percentage: "1.9%",
  },
  {
    position: "Executive",
    count: "12",
    percentage: "1.3%",
  },
];

/*
 * PROTOTYPE — headline attendance figures, rendered as stat cards above the
 * tables. Three entries fill three of the four cells by design.
 */
const quickStats = [
  { value: "906", label: t("2025 attendees") },
  { value: "732", label: t("2024 attendees") },
  { value: "600+", label: t("2023 attendees") },
];

/*
 * Residence country, same survey. The question was free text, so answers are
 * folded before ranking: "USA" / "US" / "United States of America" and typos
 * into United States, native spellings (日本, 台灣, 한국, México, Moçambique)
 * into their country, and unambiguous city answers (Berlin, Accra, Maputo)
 * into theirs. Place names shared by several countries are left unattributed.
 *
 * The long tail is the story here — the top 9 are listed and Other carries the
 * remaining 64 countries, which is why it is the second largest row.
 */
const attendeesCountries = [
  {
    position: "United States",
    count: "243",
    percentage: "26.6%",
  },
  {
    position: "Germany",
    count: "54",
    percentage: "5.9%",
  },
  {
    position: "India",
    count: "47",
    percentage: "5.1%",
  },
  {
    position: "United Kingdom",
    count: "38",
    percentage: "4.2%",
  },
  {
    position: "Netherlands",
    count: "32",
    percentage: "3.5%",
  },
  {
    position: "Ghana",
    count: "29",
    percentage: "3.2%",
  },
  {
    position: "Nigeria",
    count: "26",
    percentage: "2.8%",
  },
  {
    position: "Canada",
    count: "22",
    percentage: "2.4%",
  },
  {
    position: "Ireland",
    count: "22",
    percentage: "2.4%",
  },
  {
    position: "Other",
    count: "400",
    percentage: "43.8%",
  },
];

const attendeesPositions = [
  {
    position: "Engineer",
    count: "309",
    percentage: "33.8%",
  },
  {
    position: "Student/Intern",
    count: "247",
    percentage: "27.1%",
  },
  {
