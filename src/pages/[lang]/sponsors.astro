    count: "86",
    percentage: "9.4%",
  },
  {
    position: "Product Owner/Manager",
    count: "55",
    percentage: "6.0%",
  },
  {
    position: "Engineering/Scienstis Manager",
    count: "55",
    percentage: "6.0%",
  },
  {
    position: "Hobbyist",
    count: "34",
    percentage: "3.7%",
  },
  {
    position: "I'm currently retired",
    count: "6",
    percentage: "0.7%",
  },
];



---

<Layout title={t("Sponsors")}>
  <Container>
    <Sectionhead>
      <Fragment slot="subtitle">{t("Prospectus for the global PyLadies Conference.")}</Fragment>
      <Fragment slot="title">{t("Sponsors")}</Fragment>
      <Fragment slot="description">
        <span set:html={t("Support PyLadies as we work to improve diversity by bringing fresh talent into the Python community and to support both seasoned and budding developers through workshops, community activities, and local advocacy.")} /><br><br>
        <span set:html={t("Your support will help PyLadies provide financial support to help more women around the world with training, mentorship, and aid to attend conferences and community events.")} /><br><br>
        <span set:html={t("To learn more and to join us as a sponsor, please contact us, and a member of our sponsorship team will get back to you soon. Please get in touch by writing to <a href=\"mailto:sponsors@pyladies.com\">sponsors@pyladies.com</a>")} />
        <span class="pl-1 text-ink-strong" aria-hidden="true">
          →
        </span>
      </Fragment>
    </Sectionhead>

    <!-- Plans are parked in components/_sponsorship_plans.astro -->
    <ComingSoon
      class="mt-16"
      title={t("Sponsorship plans coming soon")}
      message={t("We are finalising the tiers and benefits for this edition. In the meantime we would still love to hear from you — get in touch and we will share the details as soon as they are ready.")}>
      <Link href="mailto:sponsors@pyladies.com" style="primary" size="lg" class="mt-8">
        {t("Contact us")}
      </Link>
    </ComingSoon>

    <div class="rounded-md p-5 xl:-8 ring-1 ring-hairline grid md:grid-cols-1 gap-10 mx-auto max-w-5xl mt-20">
      <div class="flex items-center justify-between gap-x-4">
        <h3 id="tier-enterprise" class="text-xl font-semibold leading-8 text-ink-strong">{t("Custom Sponsorship")}</h3>
        <span class="text-accent flex align-center"><Icon name="bx:heart" class="inline-icon mt-1"/>{t("Most requested")}</span>
      </div>
      <p class="text-ink-strong">
      {t("We are also happy to customize a sponsorship package to give you the freedom to choose what you think works best in order to meet your event participation goals.")}
      </p>
      <Link href="mailto:sponsors@pyladies.com" aria-describedby="tier-enterprise" style="outline" class="block w-full">
        {t("Contact us")}
      </Link>
    </div>

  </Container>


  <!-- The attendees -->
  <Container>
    <div class:list={["mt-8", "md:mt-16", align === "center" && "text-center"]}>
      <h2 class="text-3xl mt-4 text-ink-strong">
        {t("The Attendees")}
      </h2>
      {/*
        PROTOTYPE — attendee numbers as stat cards.

        The prose sits in one column and the headline numbers in the other, as a
        2x2 grid: the section title in the top-left cell and the three figures
        as cards, with the count set large in the display face.
      */}
      <div class="mt-8 grid gap-10 text-start lg:grid-cols-2 lg:gap-12">
        <div>
          <p class="text-lg">
            {t("The attendees of last year's conference represented companies and organizations from all sectors, across every experience level and more than 70 countries. The tables below break down who was in the room.")}
          </p>

          <h3 class="mt-8 text-lg font-semibold text-ink-strong">
            {t("Benefits of Sponsorship")}
          </h3>
          <ul class="mt-3 list-disc space-y-2 pl-5">
            <li>
              <span set:html={t("<strong>Targeted Audience</strong>: Reach out to a targeted market with those who could potentially become your employees. Find passionate Pythonistas to hire.")} />
            </li>
            <li>
              <span set:html={t("<strong>Branding</strong>: Increasing your brand exposure and elevating your corporate identity within the community.")} />
            </li>
            <li>
              <span set:html={t("<strong>Community Contribution</strong>: Contribute, support and sustain the underrepresented Python community.")} />
            </li>
          </ul>
        </div>

        <div>
          {/*
            The title takes the top-left cell so all four are in use. It stays
            borderless so the three figures are what read as cards. Plain <p>s
            rather than a <dl>, because a heading cannot sit inside one.
          */}
          <div class="grid grid-cols-2 gap-4">
            <h3 class="flex items-center justify-center text-center text-2xl font-bold leading-tight text-ink-strong sm:text-3xl">
              {t("Past participation")}
            </h3>
            {
              quickStats.map((stat) => (
                <div class="rounded-xl border-2 border-hairline bg-surface-raised p-6 text-center">
                  <p class="font-display text-4xl font-black leading-none text-title sm:text-5xl">
                    {stat.value}
                  </p>
                  <p class="mt-2 text-sm text-ink">{stat.label}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div class="mt-4 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        <AttendeesTable heading={t("Current Position")} rows={attendeesPositions} />
        <AttendeesTable heading={t("Experience Level")} rows={attendeesExperience} />
        <AttendeesTable
          heading={t("Residence Country")}
          rows={attendeesCountries}
          note={t("Attendees came from 72 countries in total; “Other” covers the 64 outside the top nine.")}
        />
      </div>
    </div>
  </Container>
  <SponsorsGallery showLink={false} />
</Layout>
